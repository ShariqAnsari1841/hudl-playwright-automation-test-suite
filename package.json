{
  "name": "hudl-playwright-automation-test-suite",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework for Hudl Login flow",
  "scripts": {
    "test": "cross-env env=prod npx playwright test",
    "test:prod": "cross-env env=prod npx playwright test",
    "test:staging": "cross-env env=staging npx playwright test",
    "test:headed": "cross-env env=prod npx playwright test --headed",
    "test:chromium": "cross-env env=prod npx playwright test --project=chromium",
    "test:ui": "cross-env env=prod npx playwright test --ui",
    "test:report": "npx playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "hudl"
  ],
  "author": "Shariq Ansari",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.1",
    "typescript": "^6.0.2"
  }
}
